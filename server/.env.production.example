# ==========================================================================
# Strapi PRODUCTION environment (Combell Node hosting)
# Copy to ".env" on the server and fill in real values. NEVER commit .env.
# Generate each secret with:  openssl rand -base64 16
# ==========================================================================

HOST=0.0.0.0
# Combell assigns the port via an env var / app settings. 1337 is the default;
# use whatever the Combell Node app configuration expects.
PORT=1337

# Public URL Strapi is reachable at (used by the admin panel & emails).
# e.g. https://api.tuinenko.be  or  https://tuinenko.be/strapi
URL=https://REPLACE-with-your-strapi-url

# --- security keys (REQUIRED — generate fresh, do not reuse dev keys) ---
APP_KEYS="CHANGE_ME_1,CHANGE_ME_2"
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME

# ==========================================================================
# DATABASE
# --------------------------------------------------------------------------
# Option A — MySQL (recommended on Combell; create a MySQL DB in the panel).
# --------------------------------------------------------------------------
DATABASE_CLIENT=mysql
DATABASE_HOST=REPLACE_mysql_host
DATABASE_PORT=3306
DATABASE_NAME=REPLACE_db_name
DATABASE_USERNAME=REPLACE_db_user
DATABASE_PASSWORD=REPLACE_db_password
DATABASE_SSL=false

# --------------------------------------------------------------------------
# Option B — SQLite (simplest; a single file on the server's disk).
# To use this instead, comment out the MySQL block above and uncomment:
# --------------------------------------------------------------------------
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
