# SPA fallback for React Router.
# Without this, refreshing/deep-linking to a route like /artwork/5
# returns 404 on Apache. Rewrite everything that is not a real file
# or directory back to index.html so the router can handle it.
# The app is served from the /react/ subfolder (https://tuinenko.be/react/).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /react/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /react/index.html [L]
</IfModule>

# Cache hashed build assets aggressively; never cache index.html.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
